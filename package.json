{
  "name": "boiler-hm",
  "version": "0.0.1",
  "description": "",
  "author": "Hernán Molinari - Gastón Rodríguez",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-esm -d src/config/typeorm.config.ts",
    "db:createEmpty": "node src/engine/migration-generator/runner.js",
    "db:migration:empty": "typeorm-ts-node-esm  migration:create -n ",
    "db:generate": "npm run db:migrate && npm run typeorm migration:generate",
    "db:migration:generate": "npm run typeorm migration:generate -n",
    "db:migrate": "npm run typeorm migration:run",
    "db:revert": "npm run typeorm migration:revert",
    "db:migration:run": "npm run typeorm migration:run",
    "create-engine": "node src/engine/code-generator/runner.js"
  },
  "dependencies": {
    "@eturino/ts-parse-boolean": "^1.1.3",
    "@nestjs/common": "^10.0.5",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.5",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "^2.0.2",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.5",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "^7.0.12",
    "@nestjs/typeorm": "^10.0.0",
    "bcrypt": "^5.0.1",
    "camelcase": "^8.0.0",
    "camelize": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "glob": "^11.0.0",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.7.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.2.0",
    "sharp": "^0.33.3",
    "slugify": "^1.6.6",
    "typeorm": "^0.3.7",
    "typeorm-naming-strategies": "4.1.0",
    "uppercamelcase": "^3.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.1.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.13",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.5.2",
    "@types/nodemailer": "^6.4.8",
    "@types/passport-http-bearer": "^1.0.37",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.34",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^5.5.4"
  }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - {{company}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            padding: 20px;
            text-align: center;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        .header.info { background-color: #d1ecf1; border: 1px solid #bee5eb; }
        .header.success { background-color: #d4edda; border: 1px solid #c3e6cb; }
        .header.warning { background-color: #fff3cd; border: 1px solid #ffeaa7; }
        .header.error { background-color: #f8d7da; border: 1px solid #f5c6cb; }
        
        .content {
            background-color: #ffffff;
            padding: 20px;
            border: 1px solid #e9ecef;
            border-radius: 5px;
        }
        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: #6c757d;
        }
        .button {
            display: inline-block;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            margin: 10px 0;
        }
        .button.primary { background-color: #007bff; }
        .button.success { background-color: #28a745; }
        .button.warning { background-color: #ffc107; color: #212529; }
        .button.danger { background-color: #dc3545; }
        
        .message-content {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
            border-left: 4px solid #007bff;
        }
    </style>
</head>
<body>
    <div class="header {{type}}">
        {{#if icon}}
        <div style="font-size: 24px; margin-bottom: 10px;">{{icon}}</div>
        {{/if}}
        <h1>{{title}}</h1>
        {{#if subtitle}}
        <p style="margin: 5px 0; color: #666;">{{subtitle}}</p>
        {{/if}}
    </div>
    
    <div class="content">
        {{#if name}}
        <h2>Hello {{name}}!</h2>
        {{/if}}
        
        <div class="message-content">
            {{{message}}}
        </div>
        
        {{#if details}}
        <p><strong>Details:</strong></p>
        <ul>
            {{#each details}}
            <li><strong>{{@key}}:</strong> {{this}}</li>
            {{/each}}
        </ul>
        {{/if}}
        
        {{#if actionButton}}
        <p style="text-align: center;">
            <a href="{{actionButton.url}}" class="button {{actionButton.type}}">
                {{actionButton.text}}
            </a>
        </p>
        {{/if}}
        
        {{#if additionalInfo}}
        <p style="font-size: 14px; color: #666; margin-top: 20px;">
            {{additionalInfo}}
        </p>
        {{/if}}
        
        <p>Best regards,<br>
        The {{company}} Team</p>
    </div>
    
    <div class="footer">
        <p>&copy; {{#if year}}{{year}}{{else}}{{currentYear}}{{/if}} {{company}}. All rights reserved.</p>
        {{#if timestamp}}
        <p>Sent on {{timestamp}}</p>
        {{/if}}
        {{#if unsubscribeLink}}
        <p><a href="{{unsubscribeLink}}">Unsubscribe</a> from these notifications</p>
        {{/if}}
    </div>
</body>
</html>